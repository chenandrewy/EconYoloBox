#compdef bbox
# Run:     source .host/_bbox after zsh completion initialization.
# Inputs:  the current command line only; completion does not read configuration.
# Outputs: the _bbox completion function and, when available, its compdef binding.

_bbox() {
  _arguments -s \
    '(--rebuild-without-cache)--rebuild[recreate the container using the Docker build cache]' \
    '(--rebuild)--rebuild-without-cache[recreate the container without the Docker build cache]' \
    '(--code)--shell[open a shell after bringing the container up]' \
    '(--shell)--code[open VS Code after bringing the container up]' \
    ':directory:_directories'
}

if (( $+functions[compdef] )); then
  compdef _bbox bbox
fi
