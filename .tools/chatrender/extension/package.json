{
  "name": "chatrender",
  "displayName": "ChatRender",
  "description": "Render Claude Code or Codex CLI session math live from transcripts (read-only, no network).",
  "version": "0.3.0",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onCommand:chatrender.show",
    "onCommand:chatrender.followActiveChat"
  ],
  "contributes": {
    "commands": [
      {
        "command": "chatrender.show",
        "title": "ChatRender: Show Panel"
      },
      {
        "command": "chatrender.followActiveChat",
        "title": "ChatRender: Follow Active Terminal Chat"
      }
    ]
  }
}
