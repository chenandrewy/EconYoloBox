#!/usr/bin/env bash
# Save a live Claude or Codex session into the repo-side cache.
#
# How to run (from the project directory):
#   sesh-grab SESSION_ID_OR_PREFIX
#
# Searches the current project's Claude store and the global Codex store by
# filename (both tools put the session id in the filename), then copies the
# unique match into .tools/ai-sesh/data/<project>/{claude,codex}/.
set -euo pipefail

source "$(dirname -- "${BASH_SOURCE[0]}")/_common.sh"
require_project_cwd

usage() {
  cat <<'EOF'
Usage:
  sesh-grab SESSION_ID_OR_PREFIX

Environment:
  CLAUDE_PROJECT_DIR   Override the Claude project-session store.
  CODEX_SESSIONS_DIR   Override the Codex sessions store.
EOF
}

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  usage
  exit 0
fi

query="${1:-}"
if [ -z "$query" ]; then
  usage >&2
  exit 2
fi

# Collect matches as "tool<TAB>path" lines.
matches=""
if [ -d "$claude_store" ]; then
  while IFS= read -r f; do
    matches+="claude	$f"$'\n'
  done < <(find "$claude_store" -maxdepth 1 -type f -name "$query*.jsonl")
fi
if [ -d "$codex_store" ]; then
  while IFS= read -r f; do
    matches+="codex	$f"$'\n'
  done < <(find "$codex_store" -type f -name "rollout-*$query*.jsonl")
fi
matches="$(printf '%s' "$matches" | sed '/^$/d')"

match_count="$(printf '%s\n' "$matches" | sed '/^$/d' | wc -l | tr -d ' ')"

if [ "$match_count" = "0" ]; then
  echo "No Claude or Codex session matched: $query" >&2
  echo "Searched:" >&2
  echo "  $claude_store" >&2
  echo "  $codex_store" >&2
  exit 1
fi

if [ "$match_count" != "1" ]; then
  echo "Multiple sessions matched: $query" >&2
  printf '%s\n' "$matches" >&2
  exit 1
fi

IFS=$'\t' read -r tool file <<< "$matches"

case "$tool" in
  claude) dest_dir="$claude_cache" ;;
  codex)  dest_dir="$codex_cache" ;;
esac

mkdir -p "$dest_dir"
install -m 600 "$file" "$dest_dir/"

echo "Saved $tool session:"
echo "  $file"
echo "to:"
echo "  $dest_dir/$(basename "$file")"
