#!/usr/bin/env bash
# List the current project's cached Claude seed sessions and fork one.
#
# How to run (from the project directory):
#   cc-fork --list
#   cc-fork                # prompts
#   cc-fork 1              # by number
#   cc-fork d066efc8       # by id prefix
#
# Installs the cached seeds into the home store first, then runs
# claude --resume ID --fork-session.
set -euo pipefail

source "$(dirname -- "${BASH_SOURCE[0]}")/_common.sh"
require_project_cwd

# ${VAR-default} (no colon) so an explicitly empty value disables the flag.
yolo_flag="${CLAUDE_FORK_PERMISSION_FLAG---dangerously-skip-permissions}"

usage() {
  cat <<'EOF'
Usage:
  cc-fork
  cc-fork --list
  cc-fork SESSION_ID_OR_NUMBER [claude args...]

Environment:
  CLAUDE_PROJECT_DIR           Override the Claude project-session store.
  CLAUDE_FORK_PERMISSION_FLAG  Override permission flag; set empty to omit.
EOF
}

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  usage
  exit 0
fi

if ! compgen -G "$claude_cache/*.jsonl" > /dev/null; then
  echo "No cached Claude sessions for this project in $claude_cache" >&2
  echo "Cache one with: sesh-grab SESSION_ID" >&2
  exit 1
fi

tmp_sessions="$(mktemp)"
trap 'rm -f "$tmp_sessions"' EXIT

# One line per cached session: id, short description, timestamp.
python3 - "$claude_cache" > "$tmp_sessions" <<'PY'
import json
import sys
from pathlib import Path

source_dir = Path(sys.argv[1])

def clean(text):
    return " ".join(str(text).split())

def shorten(text, n=72):
    text = clean(text)
    return text if len(text) <= n else text[: n - 3] + "..."

for path in sorted(source_dir.glob("*.jsonl")):
    session_id = path.stem
    title = None
    first_prompt = None
    timestamp = None

    with path.open(encoding="utf-8") as f:
        for line in f:
            try:
                obj = json.loads(line)
            except json.JSONDecodeError:
                continue

            session_id = obj.get("sessionId") or session_id
            if obj.get("type") == "ai-title" and obj.get("aiTitle"):
                title = clean(obj["aiTitle"])

            msg = obj.get("message")
            if (
                first_prompt is None
                and obj.get("type") == "user"
                and not obj.get("isMeta")
                and isinstance(msg, dict)
                and msg.get("role") == "user"
                and isinstance(msg.get("content"), str)
            ):
                content = clean(msg["content"])
                if content and not content.startswith("<"):
                    first_prompt = content
                    timestamp = obj.get("timestamp") or timestamp

    description = title or first_prompt or "(no prompt found)"
    print("\t".join([session_id, shorten(description), timestamp or ""]))
PY

print_sessions() {
  awk -F '\t' '{ printf "%2d  %s  %s\n", NR, $1, $2 }' "$tmp_sessions"
}

if [ "${1:-}" = "--list" ] || [ "${1:-}" = "-l" ]; then
  print_sessions
  exit 0
fi

selection="${1:-}"
if [ -n "$selection" ]; then
  shift
else
  print_sessions
  printf "Fork which session? "
  read -r selection
fi

session_id=""
if printf '%s\n' "$selection" | grep -Eq '^[0-9]+$'; then
  session_id="$(awk -F '\t' -v n="$selection" 'NR == n { print $1 }' "$tmp_sessions")"
else
  session_id="$(awk -F '\t' -v s="$selection" 'index($1, s) == 1 { print $1; exit }' "$tmp_sessions")"
fi

if [ -z "$session_id" ]; then
  echo "No cached Claude session matches: $selection" >&2
  exit 1
fi

install_cached_sessions > /dev/null

cmd=(claude --resume "$session_id" --fork-session)
if [ -n "$yolo_flag" ]; then
  cmd+=("$yolo_flag")
fi
cmd+=("$@")

exec "${cmd[@]}"
