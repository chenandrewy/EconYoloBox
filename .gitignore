# sync items
.DS_Store
__pycache__/
*.py[cod]

# User content (projects, dev, ...) lives under workspace/ and is never
# part of the sandbox repository. One structural rule instead of per-project
# name globs: anything placed there is ignored, whatever its name.
/workspace/

# Finished and retired projects move from workspace/ to done/ at the sandbox
# root. Same rule: user content, never committed.
/done/

# The cellar (research library) is shared reference material, not a project,
# so it sits beside workspace/ at the sandbox root (SANDBOX.toml `cellar`).
/cellar/

# local-only Claude Code permissions (recreated by Claude when working from ./)
.claude/settings.local.json

# editor state is personal, not shared container config
.vscode/

# agent session transcripts are a local-only cache, never committed
.tools/ai-sesh/data/
