# sync items
.DS_Store
__pycache__/
*.py[cod]

# User content (projects, library, DONE, dev, ...) lives under workspace/ and
# is never part of the sandbox repository. One structural rule instead of
# per-project name globs: anything placed there is ignored, whatever its name.
/workspace/

# local-only Claude Code permissions (recreated by Claude when working from ./)
.claude/settings.local.json

# editor state is personal, not shared container config
.vscode/

# agent session transcripts are a local-only cache, never committed
.tools/ai-sesh/data/
