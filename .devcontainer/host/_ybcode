#compdef ybcode ybe
# Run:     source .devcontainer/host/_ybcode after zsh completion initialization.
# Inputs:  the current ybcode or ybe command line only.
# Outputs: the _ybcode completion function and, when available, its compdef bindings.

_ybcode() {
  _arguments -s \
    '(--normie)--yolo[use the YOLO container (the default)]' \
    '(--yolo)--normie[use the normie container]' \
    '(--rebuild-without-cache)--rebuild[recreate both modes'"'"' containers using the Docker build cache]' \
    '(--rebuild)--rebuild-without-cache[recreate both modes'"'"' containers without the Docker build cache]' \
    ':directory:_directories'
}

if (( $+functions[compdef] )); then
  compdef _ybcode ybcode ybe
fi
