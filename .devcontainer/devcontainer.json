{
  "name": "${localWorkspaceFolderBasename}",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "TZ": "${localEnv:TZ:America/New_York}",
      "GIT_VERSION": "2.49.0",
      // Node is installed from NodeSource now that the base is ubuntu:24.04
      // rather than node:20, so its version is pinned here like the rest.
      // Keep NODE_MAJOR in step with NODE_VERSION: it selects the apt repo.
      "NODE_MAJOR": "24",
      "NODE_VERSION": "24.18.0-1nodesource1",
      "GIT_DELTA_VERSION": "0.18.2",
      "ZSH_IN_DOCKER_VERSION": "1.2.0"
    }
  },
  "userEnvProbe": "none",
  "initializeCommand": "bash -c 'bash .devcontainer/write-local-env.sh && source .devcontainer/find-python.sh && $PYTHON .devcontainer/inject-credentials.py'",
  "runArgs": [
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW",
    // bbox supplies SANDBOX.toml's strictly validated seccomp value. Direct VS
    // Code creation cannot read SANDBOX.toml, so it falls back to builtin: the
    // default YOLO posture (Docker's outer syscall filter on; the -yolo
    // launchers require it). Codex's sandboxed modes need unconfined for
    // Bubblewrap, at the cost of that filter for every process: set
    // seccomp = "unconfined" in SANDBOX.toml and run `bbox --rebuild`.
    "--security-opt=seccomp=${localEnv:SANDBOX_SECCOMP:builtin}",
    "--env-file=/tmp/devcontainer-local.env"
  ],
  "customizations": {
    "vscode": {
      // New publisher here => add its <publisher>.gallerycdn.vsassets.io
      // entry to init-firewall.sh, or the install silently fails.
      "extensions": [
        "anthropic.claude-code",
        // GitHub.copilot and GitHub.copilot-chat are built into VS Code now
        // (bundled at a newer version than the marketplace would resolve);
        // listing them here only triggered a downgrade/rollback/retry loop on
        // every attach - see docs/journal/0922a. Copilot still works built-in.
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "tamasfe.even-better-toml",
        "tomoki1207.pdf",
        "james-yu.latex-workshop",
        "donjayamanne.githistory",
        "mhutchie.git-graph",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ikuyadeu.r-pack",
        "reditorsupport.r",
        "chenandrewy.aichatrender"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "[markdown]": {
          "editor.formatOnSave": false
        },
        "[python]": {
          "editor.formatOnSave": false
        },
        "[latex]": {
          "editor.formatOnSave": false
        },
        "[tex]": {
          "editor.formatOnSave": false
        },
        "[bibtex]": {
          "editor.formatOnSave": false
        },
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },
        "window.title": "<${rootName}>${separator}${dirty}${activeEditorShort}",
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "bash",
            "icon": "terminal-bash"
          },
          "zsh": {
            "path": "zsh"
          }
        }
      }
    }
  },
  "remoteUser": "node",
  "mounts": [
    // Shared package volumes: R, Python and TeX, built on the host by
    // `bash .setup/packages.sh` (docs/journal/0921a, 0925b, 0926a) and mounted
    // read-only, so agents in here can run the stacks but never change them.
    // They are shared across projects on this Docker daemon; only per-project
    // writable state needs the ${devcontainerId} key used further down.
    // packages.sh reads these names from here. Adding a package does not
    // change them: edit the list in install-packages.sh and rerun the builder.
    //
    // Names carry distro, interpreter version and (for R) the P3M snapshot
    // date, so a bump builds a fresh volume instead of serving stale binaries.
    // Bump them with R_VERSION / CRAN_SNAPSHOT in the Dockerfile or the base
    // image's python3; the R target must match R_VERSION too (devcontainer.json
    // cannot read Dockerfile ARGs). R picks up site-library automatically
    // because the directory exists in the image. The `noble` token is
    // load-bearing: packages compiled against one distro's libraries must never
    // be mounted into another.
    //
    // To build a new volume before any container mounts it, stage it with a
    // comment line of the form `// packages.sh: <mount string>`. It overrides
    // the live mount with the same target for packages.sh only; move it here
    // once the volume passes its checks.
    //
    // Read-only unless SANDBOX.toml says packages = "writable": bbox exports
    // SANDBOX_PKG_READONLY and checks the created mounts, and direct VS Code
    // creation, which cannot read SANDBOX.toml, falls back to read-only.
    // Writable mode is for the user installing packages (docs/journal/0926a).
    "source=r-site-library-noble-4.5.3-2026-07-15-base,target=/opt/R/4.5.3/lib/R/site-library,type=volume,readonly=${localEnv:SANDBOX_PKG_READONLY:true}",
    "source=venv-noble-py3.12-base,target=/opt/venv,type=volume,readonly=${localEnv:SANDBOX_PKG_READONLY:true}",
    // Minimal pdfLaTeX-only TeX Live; the year must match TEXLIVE_YEAR.
    "source=texlive-2026-base-noble,target=/usr/local/texlive,type=volume,readonly=${localEnv:SANDBOX_PKG_READONLY:true}",
    "source=claude-code-bashhistory-${devcontainerId},target=/commandhistory,type=volume",
    // Every project-owned volume below is keyed by ${devcontainerId}, not by folder name
    // alone. anthropics/claude-code fixed this exact bug in July 2025 ("Fix
    // devcontainer volume security vulnerability"): two workspaces that share
    // a basename would otherwise mount the SAME volume, silently sharing the
    // Claude/Codex auth tokens and - via npm-global - the very executables
    // both containers run. The readable prefix is kept only so `docker volume
    // ls` stays scannable; the id is what makes the name unique.
    //
    // Cost of the id: it is derived from the host path, so moving or renaming
    // the project folder orphans these volumes (re-login + install-packages.sh cli).
    // Orphans are then unidentifiable by name; find them with
    // `docker volume ls -f dangling=true`.
    "source=${localWorkspaceFolderBasename}-claude-config-${devcontainerId},target=/home/node/.claude,type=volume",
    "source=${localWorkspaceFolderBasename}-codex-config-${devcontainerId},target=/home/node/.codex,type=volume",
    // Credentials stay out of Docker's Config.Env and are read on demand.
    // inject-credentials.py creates this host-side file before Docker starts.
    "source=/tmp/devcontainer-credentials.env,target=/run/secrets/credentials.env,type=bind,readonly",
    // The AI CLIs live here rather than in an image layer, so that updating
    // Codex in a running container is not undone by the next rebuild (a baked
    // `@latest` layer freezes at first cache; see the Dockerfile note). Codex
    // ships native per-platform binaries, so the name carries the distro AND
    // the node major - bump the token with NODE_MAJOR to start a clean volume
    // rather than serving binaries built against the wrong runtime.
    "source=${localWorkspaceFolderBasename}-npm-global-noble-node24-${devcontainerId},target=/usr/local/share/npm-global,type=volume"
  ],
  "containerEnv": {
    // TZ is intentionally absent: write-local-env.sh writes SANDBOX.toml's
    // timezone (or the detected host zone) into /tmp/devcontainer-local.env.
    // containerEnv becomes `docker run --env`, which
    // outranks --env-file, so setting it here would clobber the detected value.
    // Fallback if detection finds nothing: the Dockerfile's baked-in ARG TZ.
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    "AI_SESH_MACHINE": "${localEnv:AI_SESH_MACHINE}",
    "CODEX_HOME": "/home/node/.codex",
    "POWERLEVEL9K_DISABLE_GITSTATUS": "true",
    "LC_ALL": "C.UTF-8",
    "LANG": "C.UTF-8"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/sandbox,type=bind,consistency=delegated",
  "workspaceFolder": "/sandbox",
  // Arms the firewall (unless SANDBOX.toml says internet = "open"), seeds
  // agent guidelines, checks policy, refreshes TeX.
  "postStartCommand": "bash .devcontainer/post-start.sh",
  "waitFor": "postStartCommand"
}
