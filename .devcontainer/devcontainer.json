{
  "name": "${localWorkspaceFolderBasename}",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "TZ": "${localEnv:TZ:America/New_York}",
      "GIT_VERSION": "2.49.0",
      // Node is installed from NodeSource now that the base is ubuntu:24.04
      // rather than node:20, so its version is pinned here like the rest.
      // Keep NODE_MAJOR in step with NODE_VERSION: it selects the apt repo.
      "NODE_MAJOR": "24",
      "NODE_VERSION": "24.18.0-1nodesource1",
      "CLAUDE_CODE_VERSION": "latest",
      "CODEX_CLI_VERSION": "latest",
      "GIT_DELTA_VERSION": "0.18.2",
      "ZSH_IN_DOCKER_VERSION": "1.2.0"
    }
  },
  "userEnvProbe": "none",
  "initializeCommand": "bash -c 'bash .devcontainer/write-local-env.sh && source .devcontainer/find-python.sh && $PYTHON .devcontainer/inject-credentials.py'",
  "runArgs": [
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW",
    "--env-file=/tmp/devcontainer-local.env"
  ],
  "customizations": {
    "vscode": {
      // New publisher here => add its <publisher>.gallerycdn.vsassets.io
      // entry to init-firewall.sh, or the install silently fails.
      "extensions": [
        "anthropic.claude-code",
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "tomoki1207.pdf",
        "james-yu.latex-workshop",
        "donjayamanne.githistory",
        "mhutchie.git-graph",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ikuyadeu.r-pack",
        "reditorsupport.r",
        "chenandrewy.aichatrender"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "[markdown]": {
          "editor.formatOnSave": false
        },
        "[python]": {
          "editor.formatOnSave": false
        },
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },
        "window.title": "<${rootName}>${separator}${dirty}${activeEditorShort}",
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "bash",
            "icon": "terminal-bash"
          },
          "zsh": {
            "path": "zsh"
          }
        }
      }
    }
  },
  "remoteUser": "node",
  "mounts": [
    "source=claude-code-bashhistory-${devcontainerId},target=/commandhistory,type=volume",
    "source=${localWorkspaceFolderBasename}-claude-config,target=/home/node/.claude,type=volume",
    "source=${localWorkspaceFolderBasename}-codex-config,target=/home/node/.codex,type=volume",
    // Credentials stay out of Docker's Config.Env and are read on demand.
    // inject-credentials.py creates this host-side file before Docker starts.
    "source=/tmp/devcontainer-credentials.env,target=/run/secrets/credentials.env,type=bind,readonly",
    // Compiled-package volumes (docs/journal/0725f): installs stay at runtime
    // so image builds stay fast, but packages survive container recreation.
    // Names carry the interpreter version so an upgrade starts a fresh volume
    // instead of serving stale binaries - bump them together with R_VERSION in
    // the Dockerfile / the base image's python3. The R target must match
    // R_VERSION too (devcontainer.json cannot read Dockerfile ARGs). R picks
    // up site-library automatically because the directory exists in the image.
    //
    // The `noble` token is the distro, and it is load-bearing: these packages
    // are compiled against the base image's shared libraries, so a volume
    // filled under bookworm must never be mounted into an Ubuntu container.
    // Changing the token is what makes the base migration start clean volumes
    // automatically instead of failing at load time with ABI errors.
    "source=${localWorkspaceFolderBasename}-r-site-library-noble-4.5.3,target=/opt/R/4.5.3/lib/R/site-library,type=volume",
    "source=${localWorkspaceFolderBasename}-venv-noble-py3.12,target=/opt/venv,type=volume"
  ],
  "containerEnv": {
    // TZ is intentionally absent: write-local-env.sh detects the host zone into
    // /tmp/devcontainer-local.env. containerEnv becomes `docker run --env`, which
    // outranks --env-file, so setting it here would clobber the detected value.
    // Fallback if detection finds nothing: the Dockerfile's baked-in ARG TZ.
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    "AI_SESH_MACHINE": "${localEnv:AI_SESH_MACHINE}",
    "CODEX_HOME": "/home/node/.codex",
    "POWERLEVEL9K_DISABLE_GITSTATUS": "true",
    "LC_ALL": "C.UTF-8",
    "LANG": "C.UTF-8"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
  "workspaceFolder": "/workspace",
  // test-agent-policy.sh runs from /usr/local/bin, not /workspace, so a check of
  // the baked policy is not itself agent-writable. It is guarded and --warn-only:
  // absent before the first rebuild, and a policy regression must be loud without
  // bricking container start.
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh && bash .devcontainer/agents/seed-agent-guidelines.sh && { command -v test-agent-policy.sh >/dev/null && test-agent-policy.sh --warn-only || true; }",
  "waitFor": "postStartCommand"
}
