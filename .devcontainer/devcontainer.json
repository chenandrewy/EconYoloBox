// YOLO mode. Its twin, normie/devcontainer.json, is the same file with the
// posture flipped (seccomp, the three package mounts' readonly, and
// YOLOBOX_INTERNET), " (normie)" on the name and "normie:" at the front of
// window.title; tests/test_config_twins.py
// fails on any other difference, so edit both. Each mode is its own container,
// keyed by its config file, so neither replaces the other (docs/journal/0927a).
{
  "name": "${localWorkspaceFolderBasename}",
  "build": {
    "dockerfile": "Dockerfile",
    // The repository root, so the image can install the base with
    // .devcontainer/setup/install-base.sh (docs/journal/0926f). Dockerfile.dockerignore
    // passes only the required runtime scripts, managed policy and base installer, so
    // user content never reaches the daemon.
    "context": "..",
    "args": {
      "TZ": "${localEnv:TZ:America/New_York}",
      "GIT_VERSION": "2.49.0",
      // Node is installed from NodeSource now that the base is ubuntu:24.04
      // rather than node:20, so its version is pinned here like the rest.
      // Keep NODE_MAJOR in step with NODE_VERSION: it selects the apt repo.
      "NODE_MAJOR": "24",
      "NODE_VERSION": "24.18.0-1nodesource1",
      "GIT_DELTA_VERSION": "0.18.2",
      "ZSH_IN_DOCKER_VERSION": "1.2.0"
    }
  },
  "userEnvProbe": "none",
  "initializeCommand": "bash -c 'bash .devcontainer/host/write-local-env.sh && source .devcontainer/host/find-python.sh && $PYTHON .devcontainer/inject-credentials.py'",
  "runArgs": [
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW",
    // Posture: Docker's outer syscall filter. YOLO keeps it (builtin); normie
    // drops it (unconfined), which lets Codex's sandboxed modes use
    // Bubblewrap, at the cost of the filter for every process.
    "--security-opt=seccomp=builtin",
    "--env-file=/tmp/devcontainer-local.env",
    // Credentials, as environment variables fixed at creation. Written on the
    // host by inject-credentials.py (initializeCommand) just before Docker
    // starts; changing them means recreating the container.
    "--env-file=/tmp/devcontainer-credentials.env"
  ],
  "customizations": {
    "vscode": {
      // New publisher here => add its <publisher>.gallerycdn.vsassets.io
      // entry to init-firewall.sh, or the install silently fails.
      "extensions": [
        "anthropic.claude-code",
        // GitHub.copilot and GitHub.copilot-chat are built into VS Code now
        // (bundled at a newer version than the marketplace would resolve);
        // listing them here only triggered a downgrade/rollback/retry loop on
        // every attach - see docs/journal/0922a. Copilot still works built-in.
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "tamasfe.even-better-toml",
        "tomoki1207.pdf",
        "james-yu.latex-workshop",
        "donjayamanne.githistory",
        "mhutchie.git-graph",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ikuyadeu.r-pack",
        "reditorsupport.r",
        "chenandrewy.aichatrender"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "[markdown]": {
          "editor.formatOnSave": false
        },
        "[python]": {
          "editor.formatOnSave": false
        },
        "[latex]": {
          "editor.formatOnSave": false
        },
        "[tex]": {
          "editor.formatOnSave": false
        },
        "[bibtex]": {
          "editor.formatOnSave": false
        },
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },
        "window.title": "<${rootName}>${separator}${dirty}${activeEditorShort}",
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "bash",
            "icon": "terminal-bash"
          },
          "zsh": {
            "path": "zsh"
          }
        }
      }
    }
  },
  "remoteUser": "ubuntu",
  "mounts": [
    // Shared package volumes: R, Python and TeX. Docker seeds each empty one
    // from the image, which carries the base (docs/journal/0926f); after that
    // they change in normie mode, by `bash .devcontainer/setup/install-base.sh` in the
    // container (docs/journal/0921a, 0925b, 0926a, 0926e), and are otherwise
    // mounted read-only, so agents in here
    // can run the stacks but never change them. They are shared across
    // projects on this Docker daemon; only per-project writable state is
    // named for the checkout, further down. Adding a package does not
    // change these names: edit the list in .devcontainer/setup/install-base.sh and rerun it.
    //
    // Names carry distro, interpreter version and (for R) the P3M snapshot
    // date, so a bump builds a fresh volume instead of serving stale binaries.
    // Bump them with R_VERSION / CRAN_SNAPSHOT in the Dockerfile or the base
    // image's python3; the R target must match R_VERSION too (devcontainer.json
    // cannot read Dockerfile ARGs). R picks up site-library automatically
    // because the directory exists in the image. The `noble` token is
    // load-bearing: packages compiled against one distro's libraries must never
    // be mounted into another.
    //
    // A new volume is tried by renaming it here and running ybox --rebuild:
    // Docker seeds it, ubuntu-owned, from the image's directory, which already
    // holds the base. Rename back to abandon it.
    //
    // Posture: read-only in YOLO mode, writable in normie mode, where the user
    // installs packages (docs/journal/0926a). Both containers mount the same
    // volumes, so a running YOLO container sees what normie installs.
    "source=r-site-library-noble-4.5.3-2026-07-15-base,target=/opt/R/4.5.3/lib/R/site-library,type=volume,readonly=true",
    "source=venv-noble-py3.12-base,target=/opt/venv,type=volume,readonly=true",
    // Minimal pdfLaTeX-only TeX Live; the year must match TEXLIVE_YEAR.
    "source=texlive-2026-base-noble,target=/usr/local/texlive,type=volume,readonly=true",
    // Per-checkout volumes, shared by the YOLO and normie containers, so one
    // login and one CLI install serve both modes. They are named for the
    // checkout's folder name alone, not ${devcontainerId}: that id depends on
    // the config file, so it would give each mode its own set.
    //
    // The price is the bug anthropics/claude-code fixed in July 2025 ("Fix
    // devcontainer volume security vulnerability"): two checkouts that share
    // a basename would mount the SAME volumes, silently sharing the
    // Claude/Codex auth tokens and - via npm-global - the very executables
    // both containers run. Rule: one checkout per basename per Docker daemon.
    // post-start.sh enforces it: it records the host folder in ~/.claude on
    // first start and refuses a different one. Renaming the folder orphans
    // these volumes (re-login; startup reinstalls the CLIs); find orphans with
    // `docker volume ls -f dangling=true`.
    "source=claude-code-bashhistory-${localWorkspaceFolderBasename},target=/commandhistory,type=volume",
    "source=${localWorkspaceFolderBasename}-claude-config,target=/home/ubuntu/.claude,type=volume",
    "source=${localWorkspaceFolderBasename}-codex-config,target=/home/ubuntu/.codex,type=volume",
    // The AI CLIs live here rather than in an image layer, so that updating
    // Codex in a running container is not undone by the next rebuild (a baked
    // `@latest` layer freezes at first cache; see the Dockerfile note). Codex
    // ships native per-platform binaries, so the name carries the distro AND
    // the node major - bump the token with NODE_MAJOR to start a clean volume
    // rather than serving binaries built against the wrong runtime.
    "source=${localWorkspaceFolderBasename}-npm-global-noble-node24,target=/usr/local/share/npm-global,type=volume"
  ],
  "containerEnv": {
    // TZ is intentionally absent: write-local-env.sh writes the detected host
    // zone into /tmp/devcontainer-local.env.
    // containerEnv becomes `docker run --env`, which
    // outranks --env-file, so setting it here would clobber the detected value.
    // Fallback if detection finds nothing: the Dockerfile's baked-in ARG TZ.
    // Posture: read by post-start.sh at every start; anything but "open" arms
    // the firewall. Fixed at creation like the rest of the posture.
    "YOLOBOX_INTERNET": "firewalled",
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "CLAUDE_CONFIG_DIR": "/home/ubuntu/.claude",
    "AI_SESH_MACHINE": "${localEnv:AI_SESH_MACHINE}",
    "CODEX_HOME": "/home/ubuntu/.codex",
    "POWERLEVEL9K_DISABLE_GITSTATUS": "true",
    "LC_ALL": "C.UTF-8",
    "LANG": "C.UTF-8"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/yolobox,type=bind,consistency=delegated",
  "workspaceFolder": "/yolobox",
  // Arms the firewall (unless YOLOBOX_INTERNET is "open"), seeds
  // agent guidelines, checks policy, refreshes TeX.
  "postStartCommand": "bash .devcontainer/post-start.sh",
  "waitFor": "postStartCommand"
}
